-- Create table for booking receipts
CREATE TABLE booking_receipts (
    id INT PRIMARY KEY AUTO_INCREMENT,
    booking_id INT NOT NULL,
    receipt_data TEXT NOT NULL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (booking_id) REFERENCES bookings(id)
);

-- Create guest profiles table
CREATE TABLE guest_profiles (
    id INT PRIMARY KEY AUTO_INCREMENT,
    user_id INT NOT NULL,
    stay_history TEXT,
    preferences TEXT,
    loyalty_level INT DEFAULT 1,
    FOREIGN KEY (user_id) REFERENCES users(id)
);

-- Create database backup table
CREATE TABLE db_backup (
    id INT PRIMARY KEY AUTO_INCREMENT,
    backup_data LONGBLOB NOT NULL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- Create login attempts table
CREATE TABLE login_attempts (
    id INT AUTO_INCREMENT PRIMARY KEY,
    identifier VARCHAR(255) NOT NULL,
    attempt_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE archived_users (
    id INT PRIMARY KEY,
    username VARCHAR(100),
    email VARCHAR(100),
    password VARCHAR(100),
    role ENUM('admin', 'guest') DEFAULT 'guest',
    registration_date DATETIME,
    deletion_date DATETIME DEFAULT CURRENT_TIMESTAMP,
    last_logged_in_room INT,
    loyalty_level INT,
    deletion_reason TEXT,
    FOREIGN KEY (last_logged_in_room) REFERENCES rooms(id)
);

DELIMITER $$

-- Trigger that updates the user's stay count whenever a new booking is made
CREATE TRIGGER after_booking_insert
AFTER INSERT ON bookings
FOR EACH ROW
BEGIN
   -- Increment the stay count for the user who made the booking
   UPDATE user_stays 
   SET stay_count = stay_count + 1
   WHERE user_id = NEW.user_id;
END$$

-- Procedure to handle failed login attempts and implement account lockout
CREATE PROCEDURE HandleFailedLogin(IN p_user_id INT)
BEGIN
   -- Increment the failed login attempts counter
   UPDATE users 
   SET failed_login_attempts = failed_login_attempts + 1
   WHERE id = p_user_id;
   
   -- If user has failed 3 or more times, lock the account for 1 hour
   IF (SELECT failed_login_attempts FROM users WHERE id = p_user_id) >= 3 THEN
       UPDATE users 
       SET account_locked_until = DATE_ADD(NOW(), INTERVAL 1 HOUR)
       WHERE id = p_user_id;
   END IF;
END$$

-- Procedure to safely delete a user by marking them as deleted and logging the action
CREATE PROCEDURE DeleteUser(IN p_user_id INT)
BEGIN
    -- Start transaction
    DECLARE EXIT HANDLER FOR SQLEXCEPTION 
    BEGIN
        ROLLBACK;
        RESIGNAL;
    END;
    
    START TRANSACTION;
    
    -- First, archive the user
    INSERT INTO archived_users (
        id, username, email, password, role, 
        registration_date, last_logged_in_room, loyalty_level
    )
    SELECT 
        id, username, email, password, role, 
        registration_date, last_logged_in_room, loyalty_level
    FROM users 
    WHERE id = p_user_id;
    
    -- Delete related records from child tables
    DELETE FROM user_activity_logs WHERE user_id = p_user_id;
    DELETE FROM user_preferences WHERE user_id = p_user_id;
    DELETE FROM user_stays WHERE user_id = p_user_id;
    DELETE FROM guest_profiles WHERE user_id = p_user_id;
    DELETE FROM booking_receipts WHERE booking_id IN (
        SELECT id FROM bookings WHERE user_id = p_user_id
    );
    DELETE FROM booking_history WHERE user_id = p_user_id;
    DELETE FROM bookings WHERE user_id = p_user_id;
    
    -- Finally, delete the user
    DELETE FROM users WHERE id = p_user_id;
    
    COMMIT;
END$$
-- Event that runs every hour to automatically log out inactive users
CREATE EVENT AutoLogoutUsers
ON SCHEDULE EVERY 60 MINUTE
DO
BEGIN
   -- Log out users whose auto logout time has passed
   UPDATE users 
   SET is_logged_in = FALSE
   WHERE auto_logout_time IS NOT NULL AND auto_logout_time <= NOW();
END$$

-- Trigger to backup room data whenever a room is updated
CREATE TRIGGER after_room_update
AFTER UPDATE ON rooms
FOR EACH ROW
BEGIN
   -- Create a JSON backup of the updated room's key information
   INSERT INTO db_backup (backup_data)
   VALUES (JSON_OBJECT(
       'id', NEW.id,
       'room_number', NEW.room_number,
       'room_type', NEW.room_type
   ));
END$$

