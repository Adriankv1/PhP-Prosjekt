-- Use the correct database
CREATE DATABASE IF NOT EXISTS registration;
USE registration;

-- Create rooms table
CREATE TABLE rooms (
    id INT PRIMARY KEY AUTO_INCREMENT,
    room_number VARCHAR(10) NOT NULL,
    room_type ENUM('deluxe', 'family', 'standard', 'cheap') NOT NULL,
    max_adults INT NOT NULL,
    max_children INT NOT NULL,
    price_per_night DECIMAL(10,2) NOT NULL,
    description TEXT,
    status ENUM('available', 'occupied', 'maintenance') DEFAULT 'available'
);

-- Create users table with roles
CREATE TABLE users (
    id INT PRIMARY KEY AUTO_INCREMENT,
    username VARCHAR(100) NOT NULL UNIQUE,
    email VARCHAR(100) NOT NULL UNIQUE,
    password VARCHAR(100) NOT NULL,
    role ENUM('admin', 'guest') DEFAULT 'guest',
    registration_date DATETIME DEFAULT CURRENT_TIMESTAMP,
    last_logged_in_room INT DEFAULT NULL,
    last_login_time DATETIME DEFAULT NULL,
    is_logged_in BOOLEAN DEFAULT FALSE,
    failed_login_attempts INT DEFAULT 0,
    account_locked_until DATETIME DEFAULT NULL,
    auto_logout_time DATETIME DEFAULT NULL,
    loyalty_level INT DEFAULT 1,
    is_deleted BOOLEAN DEFAULT FALSE,
    FOREIGN KEY (last_logged_in_room) REFERENCES rooms(id)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;

-- Create bookings table
CREATE TABLE bookings (
    id INT PRIMARY KEY AUTO_INCREMENT,
    room_id INT NOT NULL,
    user_id INT NOT NULL,
    check_in_date DATE NOT NULL,
    check_out_date DATE NOT NULL,
    number_of_adults INT NOT NULL,
    number_of_children INT NOT NULL,
    total_price DECIMAL(10,2) NOT NULL,
    booking_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (room_id) REFERENCES rooms(id),
    FOREIGN KEY (user_id) REFERENCES users(id)
);

-- Create user_preferences table
CREATE TABLE user_preferences (
    id INT PRIMARY KEY AUTO_INCREMENT,
    user_id INT NOT NULL,
    preference_key VARCHAR(255) NOT NULL,
    preference_value TEXT,
    FOREIGN KEY (user_id) REFERENCES users(id)
);

-- Create booking_history table
CREATE TABLE booking_history (
    id INT PRIMARY KEY AUTO_INCREMENT,
    user_id INT NOT NULL,
    room_id INT NOT NULL,
    booking_date DATETIME NOT NULL,
    details TEXT,
    FOREIGN KEY (user_id) REFERENCES users(id),
    FOREIGN KEY (room_id) REFERENCES rooms(id)
);

-- Create user_stays table
CREATE TABLE user_stays (
    id INT PRIMARY KEY AUTO_INCREMENT,
    user_id INT NOT NULL,
    stay_count INT DEFAULT 0,
    FOREIGN KEY (user_id) REFERENCES users(id)
);

-- Create user activity logs table
CREATE TABLE user_activity_logs (
    id INT PRIMARY KEY AUTO_INCREMENT,
    user_id INT NOT NULL,
    activity_type ENUM('login', 'logout', 'preference_change', 'delete_account') NOT NULL,
    activity_timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id)
);

